// Cloudflare Workers本番設定(2026-07-14スパイク→同日本採用)。
// andyutaro.com/wwwはCustom Domains(DNS・証明書は自動管理)。
// 残TODO: R2 incremental cache(ISR永続化。現状ISRページは毎回再生成=動作は正しい)。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rede-web",
  // カスタムエントリ(2026-07-22): OpenNextのfetch+scheduled(scribe確定cron)
  "main": "worker.js",
  // 毎日15:01 UTC = 0:01 JST(Vercel Cronから移管)
  "triggers": { "crons": ["1 15 * * *"] },
  // ISRの永続キャッシュ(2026-07-23)。これが無い間、全ページが毎リクエストで
  // 再生成されていた(Error 1102の構造的な原因)。バケット名はrede-web-cache。
  // バインディング名はOpenNextの規約で固定(NEXT_INC_CACHE_R2_BUCKET)
  // ISRの作り直しキュー(2026-08-31)。これが無い間、queueの既定値は"dummy"
  // (send()が必ず例外を投げるだけの空実装)で、裏側での作り直しは稼働開始から
  // 一度も成功していなかった。Failed to revalidate stale page が1日1,087件。
  // 「保存したのに反映されない」の正体でもある。
  //
  // memory-queueではなくDurable Objectを使う理由: サービスバインディング経由の
  // 呼び出しは呼び出し元とCPU予算を共有する(公式ドキュメント)。memory-queueだと
  // 作り直しの再描画(実測100〜900ms)が閲覧者のリクエストに乗る。DOなら自分の
  // 予算で走るので、閲覧者の10ms枠を侵さない。無料プランではSQLite版のみ使える。
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "rede-web" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "rede-web-cache"
    },
    // 本文にアップした写真・動画・音源(2026-08-29)。Supabase Storageの1GB枠が
    // 動画で83%埋まったためR2へ移した。配信は media.andyutaro.com。
    // アップロードはWorker経由(/api/scribe/upload)でここへ直接書く
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "rede-web-media"
    },
    // 書いたものの控え(2026-07-23)。scribe・記事・写真はSupabaseの中にしか
    // 存在せず、無料プランには時点復旧が無い=誤って消したら戻らなかった。
    // キャッシュとは別バケットにする(こちらは消してはいけないもの)
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "rede-web-backup"
    }
  ],
  // 作り直しキューの調整(2026-09-02)。既定値のままだと無料プランで自壊する。
  //
  // 何が起きたか: キューが失敗した経路を`routeInFailedState`に溜め、`alarm()`が
  // **期限の来たものを1回のalarm呼び出しの中で全部順番に作り直す**。
  // service binding越しの描画は呼び出し元とサブリクエスト枠(無料プラン50本)を
  // 共有するので、1回のalarmに数本まとまった時点で50本を越えて全部落ちる。
  // 落ちたぶんがまた失敗状態に戻り、6回リトライして諦める——という自励振動。
  // しかも失敗状態の鍵はMessageDeduplicationIdで、同じ経路でも作り直しのたびに
  // 変わる(ライブラリ自身のコメントにそう書いてある)ので、Home1本ぶんの失敗が
  // 際限なく積み上がる。実測: 1日26,588件のエラー、Supabaseへ46,000リクエスト。
  // 有料プランなら枠が1,000本なので起きない。無料プランだけの症状。
  //
  // 効かせ方: 溜めない(リトライ1回)・同時に走らせない(1本ずつ)・
  // 10秒で切らない(冷えた拠点の描画は10秒を超えることがあり、その打ち切りが
  // 失敗状態の入口になっていた。TimeoutErrorが1日6,742件)
  "vars": {
    "NEXT_CACHE_DO_QUEUE_MAX_RETRIES": "1",
    "NEXT_CACHE_DO_QUEUE_MAX_REVALIDATION": "1",
    "NEXT_CACHE_DO_QUEUE_REVALIDATION_TIMEOUT_MS": "20000"
  },
  // 実行ログ(2026-07-23)。これが無いと本番で何が起きたか後から一切追えない
  // (1102を追えたのは分析APIの数字だけで、中身の記録は残っていなかった)。
  // cronの成否・例外のdigestはここに出る。無料枠は日20万イベント、この規模なら余る
  "observability": { "enabled": true },
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "andyutaro.com", "custom_domain": true },
    { "pattern": "www.andyutaro.com", "custom_domain": true }
  ]
}
